# Merge only if needed. Your current working HTTPS/Certbot config may already be correct.
server {
    listen 443 ssl;
    server_name liveword.longh.org;

    root /var/www/liveword/public;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/liveword.longh.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/liveword.longh.org/privkey.pem;

    location ^~ /api/celestrak/ {
        proxy_pass https://celestrak.org/NORAD/elements/;
        proxy_ssl_server_name on;
        proxy_ssl_name celestrak.org;
        proxy_set_header Host celestrak.org;
        proxy_set_header User-Agent "LIVEWORLD/0.4 (+https://liveword.longh.org)";
        proxy_set_header Accept "application/json";
        proxy_http_version 1.1;
        proxy_connect_timeout 15s;
        proxy_read_timeout 30s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
