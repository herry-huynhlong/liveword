# Đây là phần quan trọng cần MERGE vào /etc/nginx/sites-available/liveword.
# Certbot có thể đã thêm listen 443 ssl và đường dẫn certificate cho bạn.

server {
    server_name liveword.longh.org;

    # Thư mục bạn copy 3 file trong public/ vào đây
    root /var/www/liveword/public;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Browser gọi same-origin /api/celestrak/... nên không vướng CORS.
    # Dấu / cuối proxy_pass là có chủ ý.
    location /api/celestrak/ {
        proxy_ssl_server_name on;
        proxy_set_header Host celestrak.org;
        proxy_set_header User-Agent "LIVEWORLD/0.3 (+https://liveword.longh.org)";
        proxy_pass https://celestrak.org/NORAD/elements/;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # Giữ nguyên phần SSL do certbot tạo bên dưới, ví dụ:
    # listen 443 ssl;
    # ssl_certificate /etc/letsencrypt/live/liveword.longh.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/liveword.longh.org/privkey.pem;
}
