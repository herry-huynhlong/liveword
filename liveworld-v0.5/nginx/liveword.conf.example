server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name liveword.longh.org;

    root /var/www/liveword/public;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/liveword.longh.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/liveword.longh.org/privkey.pem;

    # CelesTrak GP / OMM JSON proxy. The ACTIVE list is large, so cache it at origin.
    location ^~ /api/celestrak/ {
        proxy_pass https://celestrak.org/NORAD/elements/;
        proxy_ssl_server_name on;
        proxy_ssl_name celestrak.org;
        proxy_set_header Host celestrak.org;
        proxy_set_header User-Agent "LIVEWORLD/0.5 (+https://liveword.longh.org)";
        proxy_set_header Accept "application/json";
        proxy_http_version 1.1;

        proxy_connect_timeout 15s;
        proxy_read_timeout 45s;

        proxy_cache liveworld_celestrak;
        proxy_cache_key "$scheme|$proxy_host|$request_uri";
        proxy_cache_valid 200 2h;
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;

        add_header X-Liveworld-Cache $upstream_cache_status always;
        add_header Cache-Control "no-store" always;
    }

    location /assets/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location /workers/ {
        try_files $uri =404;
        expires 1h;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name liveword.longh.org;
    return 301 https://$host$request_uri;
}
